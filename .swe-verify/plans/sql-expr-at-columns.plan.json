{
  "schema": "swe-verify/plan@1",
  "id": "sql-expr-at-columns",
  "intent": "a backtick-quoted column whose name starts with a single @ (e.g. the Elasticsearch `@timestamp` field) is allowed through the SQL expression allowlist, while a bare @user_variable of the same name -- including one forged via a backtick pair hidden in a string literal or comment -- stays blocked",
  "domain": "fullstack",
  "scope": {
    "include": [
      "pkg/expr/sql/**"
    ]
  },
  "fixture": {
    "kind": "process",
    "language": "go",
    "program": ".",
    "file": "pkg/expr/sql/x",
    "mode": "test",
    "args": [
      "-test.run",
      "TestAllowQuery/.*(backtick|@)",
      "-test.v"
    ],
    "awaitExit": true
  },
  "steps": [],
  "coverage": {
    "policy": "all-executable",
    "waivers": [
      {
        "file": "pkg/expr/sql/parser_allow.go",
        "lines": "296",
        "reason": "unreachable: backtickQuotedNames runs only after sqlparser.Parse succeeds, so an unterminated string literal fails the parse first and never reaches this fallback",
        "expires": "2027-08-25"
      },
      {
        "file": "pkg/expr/sql/parser_allow.go",
        "lines": "314",
        "reason": "unreachable: an unterminated block comment fails sqlparser.Parse before the scanner runs",
        "expires": "2027-08-25"
      },
      {
        "file": "pkg/expr/sql/parser_allow.go",
        "lines": "337",
        "reason": "unreachable: an unterminated backtick identifier fails sqlparser.Parse before the scanner runs",
        "expires": "2027-08-25"
      }
    ]
  },
  "assertions": [
    {
      "id": "fix-allows-quoted-at-timestamp",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/allowed:_backtick-quoted_`@timestamp`_column (0.00s)"
      }
    },
    {
      "id": "system-variable-still-blocked",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@@hostname (0.00s)"
      }
    },
    {
      "id": "quoting-does-not-exempt-system-variable",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@@hostname_stays_blocked_even_when_backtick-quoted (0.00s)"
      }
    },
    {
      "id": "bare-user-variable-still-blocked",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@user_variable (0.00s)"
      }
    },
    {
      "id": "obfuscation-via-string-literal-still-blocked",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@myvar_is_not_exempted_by_a_backtick_pair_inside_a_single-quoted_string (0.00s)"
      }
    },
    {
      "id": "obfuscation-via-comment-still-blocked",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@myvar_is_not_exempted_by_a_backtick_pair_inside_a_--_comment (0.00s)"
      }
    },
    {
      "id": "obfuscation-via-mid-query-comment-still-blocked",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@myvar_is_not_exempted_by_a_backtick_pair_inside_a_mid-query_--_comment (0.00s)"
      }
    },
    {
      "id": "obfuscation-via-double-slash-comment-still-blocked",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@myvar_is_not_exempted_by_a_backtick_pair_inside_a_//_comment (0.00s)"
      }
    },
    {
      "id": "obfuscation-via-backslash-escaped-string-still-blocked",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "contains": "--- PASS: TestAllowQuery/blocked:_@myvar_is_not_exempted_by_a_backtick_pair_inside_a_backslash-escaped_string (0.00s)"
      }
    },
    {
      "id": "no-other-failures-in-suite",
      "kind": "terminal-match",
      "afterStep": 0,
      "expect": {
        "absent": "FAIL"
      }
    }
  ],
  "record": {
    "terminal": {
      "steps": [
        {
          "caption": "go test ./pkg/expr/sql/... -run 'TestAllowQuery/.*(backtick|@)' -v -count=1",
          "command": "go test ./pkg/expr/sql/... -run 'TestAllowQuery/.*(backtick|@)' -v -count=1",
          "waitMs": 30000
        }
      ]
    }
  }
}
